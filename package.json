{
  "name": "11ty-blog-starter-optimized",
  "version": "1.0.0",
  "description": "A performance-optimized 11ty blog starter with modern build tools",
  "main": "index.js",
  "scripts": {
    "build": "eleventy",
    "build:prod": "NODE_ENV=production eleventy",
    "dev": "eleventy --serve --watch",
    "clean": "rm -rf _site",
    "analyze": "npm run build:prod && node scripts/performance-audit.js",
    "lighthouse": "lhci autorun",
    "perf": "npm run build:prod && npm run analyze && npm run lighthouse",
    "audit": "node scripts/performance-audit.js",
    "optimize": "npm run clean && npm run build:prod && npm run audit"
  },
  "keywords": ["11ty", "eleventy", "blog", "performance", "optimization"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^3.1.8",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "clean-css": "^5.3.2",
    "cssnano": "^6.0.1",
    "esbuild": "^0.19.8",
    "html-minifier": "^4.0.0",
    "postcss": "^8.4.32",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.6",
    "@lhci/cli": "^0.12.0",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "dependencies": {
    "markdown-it": "^13.0.2",
    "markdown-it-anchor": "^8.6.7"
  }
}